 R←TestInventory;m;b;table;new;tradfns;constants;modern;retired;missing;notdfn;nottrad;present;camel;extra;src
⍝ Every modern function is present under its agreed bicameral name:
⍝ a dfn, except the agreed tradfns, which are niladic and not constants.
⍝ Immutable constants are upper-case variables.
⍝ Book names replaced by modern names are absent, and there are no
⍝ functions besides these. The WebApp class is the book's, calling the
⍝ modern names.
 m←## ⋄ b←##.Data ⋄ R←1

⍝ book name, modern name: converted to dfns, or revised in stages 2–4
 table←('ARCCOS' 'ArcCos')('ARCSIN' 'ArcSin')('ARCTAN' 'ArcTan')('COS' 'Cos')('SIN' 'Sin')('TAN' 'Tan')
 table,←('RADIAN' 'Radian')('DEGREES' 'Degrees')('SQRT' 'Sqrt')('NORM' 'Norm')('TIMES' 'Times')
 table,←('KEPLERFN' 'KeplerFn')('KEPDERIV' 'KepDeriv')('KEPLINVERSE' 'KeplInverse')('TRUEANOMALY' 'TrueAnomaly')
 table,←('CARTESIAN' 'Cartesian')('CARTRIPLET' 'CarTriplet')('COALTITUDE' 'Coaltitude')('PROJECTION' 'Projection')
 table,←('VISIBLE' 'Visible')('MAPCARTESIAN' 'MapCartesian')('MOONPHASE' 'MoonPhase')('TIMEADJUST' 'TimeAdjust')
 table,←('LATROTATE' 'LatRotate')('INCLROTATE' 'InclRotate')('LONGROTATE' 'LongRotate')
 table,←('JNU' 'Jnu')('JNUINV' 'JnuInv')('DAYNAME' 'DayName')('RADECDIST' 'RaDecDist')
 table,←('PLANETPOS' 'PlanetPos')('PLANETSPOS' 'PlanetsPos')('COMETPOS' 'CometPos')('EPOCHADJUST' 'EpochAdjust')
 table,←('EARTHVIEW' 'EarthView')('MOONPOS' 'MoonPos')('PRECESS' 'Precess')('SKYPOS' 'SkyPos')('PARALLAXADJUST' 'ParallaxAdjust')
 table,←('SEMIMAJOR' 'SemiMajor')('PERIOD' 'Period')('ECCENTRICITY' 'Eccentricity')('INCLINATION' 'Inclination')
 table,←('ASCENDING' 'Ascending')('PERIANGLE' 'Periangle')('ANOMALY' 'Anomaly')('SECULAR' 'Secular')
 table,←('EPOCHDATE' 'EpochDate')('ANOMALYDATE' 'AnomalyDate')('PERIDIST' 'PeriDist')('PERIDATE' 'PeriDate')
 table,←('RADIUS' 'Radius')('ORBROTATE' 'OrbRotate')('PERIODER' 'Perioder')('AREA' 'Area')('AREADERIV' 'AreaDeriv')
 table,←('PARABOLA' 'Parabola')('COMETSOLVE' 'CometSolve')
 table,←('CALCULATEPLANETS' 'CalculatePlanets')('CALCULATESTARS' 'CalculateStars')('ENTRY' 'SkyAt')
 table,←('CAPTION' 'Caption')('REPORTPLANETS' 'ReportPlanets')('PLOTSTARS' 'PlotStars')
 table,←('REPORTSTARS' 'ReportStars')('PRINTED' 'Printed')('WORK' 'Work')
 table,←('PLOTSVG' 'PlotSvg')('FRAMESVG' 'FrameSvg')('SAVESVG' 'SaveSvg')
 table,←('ANIMATE' 'Animate')('ANIMATEDSVG' 'AnimatedSvg')('MAKEVIDEO' 'MakeVideo')

⍝ new dfns, with no book counterpart: shared caption parts, and the parts
⍝ of PlotSvg and AnimatedSvg, which split the book's long functions
 new←'Place' 'Clock' 'SvgStyle' 'SvgMap' 'SvgLegend' 'SvgPlanetTable' 'SvgStarTable'
 new,←'AnimFrames' 'AnimJson' 'AnimHead' 'AnimBodies' 'AnimTables' 'AnimControls'
 new,←'AnimScript' 'AnimScriptData' 'AnimScriptSky' 'AnimScriptTables' 'AnimScriptPlayback' 'AnimScriptTips'

⍝ niladic tradfns that are not constants: prompts, entry points, demonstrations,
⍝ the web server, and Initialise, which sets the constants
 tradfns←'GetDate' 'GetTime' 'GetLat' 'GetLong' 'Entry' 'Display' 'ExampleRender' 'Initialise'
 tradfns,←'ExampleSvg' 'StartServ'
 constants←'PI' 'EARTH'
 modern←(2⊃¨table),new
 retired←(⊃¨table),'GETDATE' 'GETTIME' 'GETLAT' 'GETLONG' 'DISPLAY' 'EXAMPLE_RENDER' 'IF'
 retired,←'EXAMPLE_SVG' 'STARTSERV'

 missing←(modern,tradfns)/⍨3≠⌊m.⎕NC modern,tradfns
 :If 0≠≢missing
     ⎕←'FAIL: TestInventory: missing: ',⍕missing ⋄ R←0
 :EndIf
 notdfn←modern/⍨3.2≠m.⎕NC modern
 :If 0≠≢notdfn
     ⎕←'FAIL: TestInventory: not a dfn: ',⍕notdfn ⋄ R←0
 :EndIf
 nottrad←tradfns/⍨{(3.1≠m.⎕NC⊂⍵)∨(1 0 0≢3↑⊃m.⎕AT ⍵)∧0 0 0≢3↑⊃m.⎕AT ⍵}¨tradfns
 :If 0≠≢nottrad
     ⎕←'FAIL: TestInventory: not a niladic tradfn: ',⍕nottrad ⋄ R←0
 :EndIf
 camel←{(∨/⍵∊⎕A)∧∨/⍵∊⎕C ⎕A}                ⍝ bicameral: upper and lower case
 :If ~∧/camel¨modern,tradfns
     ⎕←'FAIL: TestInventory: not bicameral: ',⍕(modern,tradfns)/⍨~camel¨modern,tradfns ⋄ R←0
 :EndIf
 :If ~∧/2=⌊m.⎕NC constants
     ⎕←'FAIL: TestInventory: not a variable: ',⍕constants/⍨2≠⌊m.⎕NC constants ⋄ R←0
 :ElseIf (○1)≢m.PI
     ⎕←'FAIL: TestInventory: PI is not ○1' ⋄ R←0
 :ElseIf b.EARTH≢m.EARTH
     ⎕←'FAIL: TestInventory: EARTH differs from book' ⋄ R←0
 :EndIf
 extra←(m.⎕NL ¯3)~modern,tradfns
 :If 0≠≢extra
     ⎕←'FAIL: TestInventory: unexpected functions: ',⍕extra ⋄ R←0
 :EndIf
 :If 9.4≠m.⎕NC⊂'WebApp'
     ⎕←'FAIL: TestInventory: WebApp class missing' ⋄ R←0
 :Else
     src←'ns\.ANIMATEDSVG' 'ns\.ANIMATE' 'ns\.MAKEVIDEO'⎕R'ns.AnimatedSvg' 'ns.Animate' 'ns.MakeVideo'⊢⎕SRC b.WebApp
     :If src≢⎕SRC m.WebApp
         ⎕←'FAIL: TestInventory: WebApp differs from the book''s other than in the names it calls' ⋄ R←0
     :EndIf
 :EndIf
 present←retired/⍨0≠m.⎕NC retired
 :If 0≠≢present
     ⎕←'FAIL: TestInventory: retired names present: ',⍕present ⋄ R←0
 :EndIf
 :If R
     ⎕←'PASS: TestInventory (',(⍕≢modern),' dfns, ',(⍕≢tradfns),' tradfns, ',(⍕≢constants),' constants)'
 :EndIf
