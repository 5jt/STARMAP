AnimScriptTips←{
   ⍝ JavaScript for the animated SVG: star and planet tooltips, hover
   ⍝ handlers, and the start of playback
    fjs←{'¯'⎕R'-'⊢⍕⍵}
    pad←80
    ∊(
        ⍝ Star info tooltip
        'const tt=document.getElementById("tooltip");'
        'let ttStar=-1;'
        'function fmtRA(h){const hh=Math.floor(h),mm=Math.round((h-hh)*60);return hh+"h "+mm+"m";}'
        'function fmtDec(d){const s=d<0?"\u00AF":"";const a=Math.abs(d);return s+Math.round(a)+"\u00B0";}'
        'const cp=document.getElementById("const-path");'
        'function showConstLines(con){'
        'const pairs=CG[con];'
        'if(!pairs||!pairs.length){cp.setAttribute("visibility","hidden");return;}'
        'let d="";'
        'for(let j=0;j<pairs.length;j++){'
        'const a=document.getElementById("s"+pairs[j][0]),b=document.getElementById("s"+pairs[j][1]);'
        'if(a.getAttribute("visibility")==="hidden"||b.getAttribute("visibility")==="hidden")continue;'
        'd+="M"+a.getAttribute("cx")+","+a.getAttribute("cy")+"L"+b.getAttribute("cx")+","+b.getAttribute("cy");}'
        'if(d){cp.setAttribute("d",d);cp.setAttribute("visibility","visible");}'
        'else{cp.setAttribute("visibility","hidden");}}'
        'function showTooltip(i){'
        'const el=document.getElementById("s"+i);'
        'if(el.getAttribute("visibility")==="hidden"){hideTooltip();return;}'
        'ttStar=i;'
        'const cx=+el.getAttribute("cx"),cy=+el.getAttribute("cy");'
        'let tx=cx+20,ty=cy-130;'
        'if(ty<',(fjs pad),')ty=cy+20;'
        'if(tx+340>',(fjs pad+2160),')tx=cx-360;'
        'tt.setAttribute("transform","translate("+tx+","+ty+")");'
        'document.getElementById("tt-dot").setAttribute("r",BRIGHT[i]?8:3);'
        'document.getElementById("tt-dot").setAttribute("fill",BRIGHT[i]?"#ffd700":"#aaa");'
        'document.getElementById("tt-name").textContent=SNAMES[i];'
        'document.getElementById("tt-const").textContent=CF[SCONST[i]]||SCONST[i];'
        'document.getElementById("tt-radec").textContent="RA "+fmtRA(SRA[i])+"  Dec "+fmtDec(SDEC[i]);'
        'document.getElementById("tt-altaz").textContent="Alt "+Math.round(starAlt[i])+"\u00B0  Az "+Math.round(starAz[i])+"\u00B0";'
        'tt.setAttribute("visibility","visible");'
        'const pairs=CG[SCONST[i]];'
        'if(pairs&&pairs.some(p=>p[0]===i||p[1]===i)){showConstLines(SCONST[i]);}'
        'else{cp.setAttribute("visibility","hidden");}}'
        'function hideTooltip(){tt.setAttribute("visibility","hidden");cp.setAttribute("visibility","hidden");ttStar=-1;}'
        ⍝ Planet tooltip
        'const PNAMES=[',(1↓∊',',¨{'"',⍵,'"'}¨11↑Data.PLANETNAMES),'];'
        'function showPlanetTooltip(i,fi){'
        'ttStar=-1;'
        'const pe=document.getElementById("p"+i);'
        'const px=+pe.getAttribute("x"),py=+pe.getAttribute("y");'
        'let tx=px+20,ty=py-130;'
        'if(ty<',(fjs pad),')ty=py+20;'
        'if(tx+340>',(fjs pad+2160),')tx=px-360;'
        'tt.setAttribute("transform","translate("+tx+","+ty+")");'
        'document.getElementById("tt-dot").setAttribute("r",10);'
        'document.getElementById("tt-dot").setAttribute("fill","#4fc3f7");'
        'document.getElementById("tt-name").textContent=PNAMES[i];'
        'document.getElementById("tt-const").textContent="";'
        'const rah=PD.rah[i][fi],ram=PD.ram[i][fi],dec=PD.dec[i][fi];'
        'document.getElementById("tt-radec").textContent="RA "+rah+"h "+ram+"m  Dec "+hm(dec)+"\u00B0";'
        'document.getElementById("tt-altaz").textContent="Alt "+hm(PD.alt[i][fi])+"\u00B0  Az "+hm(PD.az[i][fi])+"\u00B0";'
        'tt.setAttribute("visibility","visible");}'
        ⍝ Hover handlers on star circles
        'for(let i=0;i<SRA.length;i++){'
        'document.getElementById("s"+i).addEventListener("mouseover",function(){'
        'showTooltip(+this.id.slice(1));});'
        'document.getElementById("s"+i).addEventListener("mouseout",hideTooltip);}'
        ⍝ Hover handlers on planet symbols
        'for(let i=0;i<PD.px.length;i++){'
        'document.getElementById("p"+i).addEventListener("mouseover",(function(idx){'
        'return function(){showPlanetTooltip(idx,frame);};})(i));'
        'document.getElementById("p"+i).addEventListener("mouseout",hideTooltip);}'
        ⍝ Start
        'renderFrame(0);updateUI();'
        'animId=requestAnimationFrame(step);'
    ) }
