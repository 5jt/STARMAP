AnimHead←{
   ⍝ Start of the animated SVG, ⍵ high: style sheet, background, title
   ⍝ (filled in by script), crosshairs, horizon, cardinal points, zenith,
   ⍝ legend, and the path for constellation figures (drawn by script)
    pad←80 ⋄ c←pad+1080 ⋄ r←1080
    fmt←{⍕⌊0.5+⍵}
    style←∊(
        '.bst-row text{font-size:26px;fill:#999}'
        '.bst-val{text-anchor:end}'
        '.bst-row.dim text{fill:#555}'
        '.pt-row text{font-size:26px;fill:#999}'
        '.pt-val{text-anchor:end}'
        '.pt-row.dim text{fill:#555}'
        '.bright,.faint{cursor:pointer;stroke:transparent;stroke-width:16;pointer-events:all}'
        '#tooltip rect{fill:#1a1a2e;stroke:#4fc3f7;stroke-width:1}'
        '#tooltip text{font-family:monospace}'
    )
    ∊(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ',(⍕2160+2×pad),' ',(⍕⍵),'">'
        SvgStyle style
        '<rect width="',(⍕2160+2×pad),'" height="',(⍕⍵),'" fill="#0a0a1a"/>'
        '<text class="title" id="title" x="',(⍕pad+1080),'" y="',(⍕pad-20),'"> </text>'
        '<g stroke="#333" stroke-width="1">'
        '<line x1="',(⍕pad),'" y1="',(⍕c),'" x2="',(⍕pad+2160),'" y2="',(⍕c),'"/>'
        '<line x1="',(⍕c),'" y1="',(⍕pad),'" x2="',(⍕c),'" y2="',(⍕pad+2160),'"/>'
        '</g>'
        '<circle cx="',(⍕c),'" cy="',(⍕c),'" r="',(⍕r),'" fill="none" stroke="#555" stroke-width="2"/>'
        '<text class="cardinal" x="',(⍕c),'" y="',(fmt c-r-20),'">N</text>'
        '<text class="cardinal" x="',(⍕c),'" y="',(fmt c+r+35),'">S</text>'
        '<text class="cardinal" x="',(fmt c-r-25),'" y="',(⍕c),'">E</text>'
        '<text class="cardinal" x="',(fmt c+r+25),'" y="',(⍕c),'">W</text>'
        SvgLegend pad
        '<path id="const-path" d="" fill="none" stroke="#446" stroke-width="1.5" visibility="hidden"/>'
    ) }
